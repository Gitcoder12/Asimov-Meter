{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gitcoder12/Asimov-Meter-/blob/main/data/observation.schema.json",
  "title": "Asimov-Meter Observation",
  "description": "One sourced numeric observation about an AI or robotics system. This schema validates record shape, not truth or causal validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "system", "sector", "indicator", "direction", "value", "unit",
    "period_start", "period_end", "population", "method", "source_url", "verification"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "system": {"type": "string", "minLength": 1},
    "sector": {"type": "string", "minLength": 1},
    "indicator": {"type": "string", "minLength": 1},
    "direction": {"type": "string", "enum": ["benefit", "harm", "mixed", "unknown"]},
    "value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "population": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "verification": {"type": "string", "enum": ["reported", "independently_verified"]},
    "notes": {"type": "string"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
